# Copiar a backend/.env para desarrollo; nunca subir el .env real
PORT=4000
NODE_ENV=development
FIREBASE_PROJECT_ID=ayvar-pos
FRONTEND_URL=http://localhost:5173
# Solo Vercel: JSON completo en una variable sensible. Nunca usar el prefijo VITE_.
# En local se conserva secrets/firebase-service-account.json; Cloud Run conserva ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Configuración SMTP opcional; sin ella no podrán enviarse invitaciones
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
